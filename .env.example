# ==============================================================================
# NOBARIN CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya
# ==============================================================================

# 1. Supabase Backend Configuration
# Dapatkan URL & Anon Key dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://afqauloszakvukebwzdl.supabase.co
SUPABASE_ANON_KEY=sb_publishable_QFrZVWOv5mzBQBUwjsKiCw_W15Zh5md

# 2. WebRTC P2P Voice Chat Configuration (STUN / TURN)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
# Opsional: Konfigurasi TURN server untuk koneksi di balik NAT/firewall ketat
WEBRTC_TURN_SERVER=turn:turn.example.com:3478
WEBRTC_TURN_USERNAME=username
WEBRTC_TURN_CREDENTIAL=credential

# 3. Google Drive / Multi-platform OAuth Configuration
# Web Client ID dari Google Cloud Console (Dibutuhkan untuk Web dan sebagai serverClientId di Android/iOS)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# iOS Client ID dari Google Cloud Console (Dibutuhkan untuk build iOS/macOS)
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
